# URL base del backend Spring Boot (sin barra final). No incluir secretos.
# En el despliegue cloud debe ser la URL de Google Cloud API Gateway, no localhost.
VITE_API_BASE_URL=http://localhost:8080

# Microsoft Entra ID (valores públicos; nunca poner client secrets en el frontend).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Scopes de la API separados por coma: api://<client-id-de-la-API>/orders.read,api://<client-id-de-la-API>/orders.write
VITE_ENTRA_API_SCOPES=
