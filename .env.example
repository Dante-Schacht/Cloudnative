# Plantilla de variables para docker compose. Copiar a ".env" (ignorado por git) y reemplazar
# TODOS los valores "change-me" por secretos locales propios. No subir el archivo .env.

# Credenciales del clúster RabbitMQ (usuario de aplicación; no usar "guest").
RABBITMQ_USERNAME=cloudorders
RABBITMQ_PASSWORD=change-me
# Cookie Erlang compartida por los nodos del clúster (cadena larga y aleatoria).
RABBITMQ_ERLANG_COOKIE=change-me

# Credenciales HTTP Basic de la API de administración (rabbitmq-admin-service).
ADMIN_API_USERNAME=admin
ADMIN_API_PASSWORD=change-me

# Origen permitido por CORS en order-service (frontend Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo pruebas locales: habilita fallos simulados en notification-service (marcas en "notes").
NOTIFICATION_SIMULATION_ENABLED=false
